{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "description": "Base preset with common settings for STM32 development",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "ARM_TOOLCHAIN_PATH": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.11.3.rel1.win32_1.1.0.202305231506/tools/bin",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Micromouse - Template",
            "displayName": "Micromouse Template",
            "description": "Configure for standard Micromouse template build",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-toolchain.cmake",
                "TARGET_DEVICE": "STM32L476xx"
            }
        },
        {
            "name": "Micromouse - Diagnostics",
            "displayName": "Micromouse Diagnostics",
            "description": "Standalone image that brings up every peripheral bus one at a time, probes whatever hardware should be behind it (INA219, IMU, SSD1306, 9x VL53L0X, ZD25WQ80C), and reports PASS/FAIL per item over USART1. Never drives motors or touches internal flash.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-toolchain.cmake",
                "TARGET_DEVICE": "STM32L476xx",
                "DIAGNOSTICS_BUILD": "ON"
            }
        },
        {
            "name": "MicroMouse - C Template",
            "displayName": "Custom configure preset",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "External Flash Dumper",
            "displayName": "External Flash Dumper",
            "description": "Standalone image that brings up SPI2 + the ZD25WQ80C external flash and streams its contents over USART1 (read-only)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-toolchain.cmake",
                "TARGET_DEVICE": "STM32L476xx",
                "FLASH_DUMPER_BUILD": "ON"
            }
        },
        {
            "name": "External Flash Writer",
            "displayName": "External Flash Writer",
            "description": "Standalone image that mass-erases the ZD25WQ80C external flash, then writes FLASH_WRITE_STRING (edit in FlashWriter_main.c) to address 0 and verifies it over USART1",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-toolchain.cmake",
                "TARGET_DEVICE": "STM32L476xx",
                "FLASH_WRITER_BUILD": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "MicroMouse - C Template",
            "configurePreset": "MicroMouse - C Template",
            "jobs": 4
        },
        {
            "name": "MicroMouse - Diagnostics",
            "configurePreset": "MicroMouse - Diagnostics",
            "jobs": 4
        },
        {
            "name": "External Flash Dumper",
            "configurePreset": "External Flash Dumper",
            "jobs": 4
        },
        {
            "name": "External Flash Writer",
            "configurePreset": "External Flash Writer",
            "jobs": 4
        }
    ]
}
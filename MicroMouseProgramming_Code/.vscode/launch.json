{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MicroMouse (CMake)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "configFiles": ["openocd.cfg"],
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32L476",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 10
            },
            "postRestartCommands": [
                "break main",
                "continue"
            ],
            "gdbPath": "${config:cortex-debug.armToolchainPath}/arm-none-eabi-gdb.exe",
            "objdumpPath": "${config:cortex-debug.armToolchainPath}/arm-none-eabi-objdump.exe",
            "toolchainPrefix": "${config:cortex-debug.armToolchainPath}/arm-none-eabi",
            "showDevDebugOutput": "parsed"
        },

        {
            "name": "Attach MicroMouse (CMake)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "configFiles": ["openocd.cfg"],
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32L476",
            "gdbPath": "${config:cortex-debug.armToolchainPath}/arm-none-eabi-gdb.exe",
            "objdumpPath": "${config:cortex-debug.armToolchainPath}/arm-none-eabi-objdump.exe",
            "toolchainPrefix": "${config:cortex-debug.armToolchainPath}/arm-none-eabi",
            "showDevDebugOutput": "parsed"
        },
        {
            "name": "Debug MicroMouse Web Interface",
            "type": "python",
            "request": "launch",
            "program": "${workspaceRoot}/Scripts/micromouse_interface.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceRoot}",
            "env": {"FLASK_ENV": "development"},
            "preLaunchTask": "Install Python Dependencies"
        }
    ]
}